FROM python:3.10

WORKDIR /app

COPY requirement.txt .
RUN pip install --no-cache-dir -r requirement.txt -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN timeout 60 playwright install --with-deps chromium || echo "WARNING: playwright chromium install failed or timed out, skipping" || true

COPY . .

# Inside a container `localhost` is the container itself, so a DSN host of
# `localhost` cannot reach a database published on the host. Rewrite ONLY the
# host part `@localhost:` -> `@host.docker.internal:`; the PORT is taken verbatim
# from config/config.yaml, so changing the published port never requires touching
# this Dockerfile (set the DSN port in config.yaml to the host-published port).
# Explicit non-localhost DSNs (an external / remote MySQL) are left untouched.
# config/config.yaml remains the single source of truth at runtime (no env).
RUN sed -i -E 's/@localhost:/@host.docker.internal:/g' config/config.yaml

EXPOSE 8008

COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]