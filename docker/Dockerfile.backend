FROM python:3.10

WORKDIR /app

COPY requirement.txt .
RUN pip install --no-cache-dir -r requirement.txt -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN timeout 60 playwright install --with-deps chromium || echo "WARNING: playwright chromium install failed or timed out, skipping" || true

COPY . .

# Point the SQLAlchemy DSNs (mysql / mysql_readonly / mysql_sys) at the compose
# MySQL service. Only the `@localhost:` host part of the URLs is rewritten, so
# other config values (static_path etc.) are left untouched; runtime env
# overrides (MYSQL_URL / MYSQL_READONLY_URL / MYSQL_SYS_URL) still win.
RUN sed -i -E 's/@localhost:/@mysql:/g' config/config.yaml

EXPOSE 8008

COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]